# Application
APP_NAME="UPSWING"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Database
# For local development (SQLite)
DATABASE_URL=sqlite:///./upswing.db
# For production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/upswing

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# API
API_V1_STR=/api/v1

# ML Config
ML_MODEL_PATH=models/v1/model.joblib
RISK_CONFIG_PATH=configs/risk_rules.yaml
RECOMMENDATIONS_CONFIG_PATH=configs/recommendations.yaml

# Risk Scoring Weights
ML_WEIGHT=0.65
RULE_WEIGHT=0.35

# Thresholds
LOW_RISK_THRESHOLD=40
HIGH_RISK_THRESHOLD=70

# Jobs
ENABLE_SCHEDULER=false
SCORING_SCHEDULE_CRON="0 2 * * 1"  # Every Monday at 2 AM

# Logging
LOG_LEVEL=INFO
